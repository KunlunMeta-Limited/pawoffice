        <mxCell id="submit" value="1. POST message + requestID&#xa;Browser ACK timeout: 12s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;fontSize=12;" edge="1" parent="1" source="browser" target="gateway"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="150"/><mxPoint x="460" y="150"/></Array></mxGeometry></mxCell>
        <mxCell id="prompt" value="2. POST prompt_async&#xa;Gateway ACK timeout: 5s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;fontSize=12;" edge="1" parent="1" source="gateway" target="host"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="220"/><mxPoint x="790" y="220"/></Array></mxGeometry></mxCell>
        <mxCell id="run" value="3. save checkpoint / run turn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#ea580c;fontSize=12;" edge="1" parent="1" source="host" target="loop"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="290"/><mxPoint x="1115" y="290"/></Array></mxGeometry></mxCell>
        <mxCell id="stream" value="4. HTTPS + SSE&#xa;TCP connect: 15s&#xa;build stream / next frame idle: 120s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#ea580c;fontSize=12;" edge="1" parent="1" source="loop" target="provider"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1115" y="370"/><mxPoint x="1435" y="370"/></Array></mxGeometry></mxCell>

        <mxCell id="failure" value="5. timeout / reset / EOF / stream read / decode error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;fontColor=#991b1b;fontSize=12;" edge="1" parent="1" source="provider" target="loop"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1435" y="460"/><mxPoint x="1115" y="460"/></Array></mxGeometry></mxCell>
        <mxCell id="retry" value="无 TextDelta：最多重试 3 次&#xa;已有正文：不重放，直接失败" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="500" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="error-host" value="6. Error::Timeout 或 RetryableTransient" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;fontColor=#991b1b;fontSize=12;" edge="1" parent="1" source="loop" target="host"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1115" y="610"/><mxPoint x="790" y="610"/></Array></mxGeometry></mxCell>
        <mxCell id="rollback" value="7. session = checkpoint&#xa;persist failed turn outcome&#xa;code = provider_timeout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="650" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="poll" value="8. GET status + messages + turns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=12;" edge="1" parent="1" source="gateway" target="host"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="770"/><mxPoint x="790" y="770"/></Array></mxGeometry></mxCell>
        <mxCell id="mapped" value="9. Gateway maps code to fixed Chinese text" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;fontColor=#991b1b;fontSize=12;dashed=1;" edge="1" parent="1" source="gateway" target="browser"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="840"/><mxPoint x="155" y="840"/></Array></mxGeometry></mxCell>

        <mxCell id="frontend-note" value="前端 monitor 的 120s 只改变 UI 为“正在核对本轮状态”，不会 abort Host。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="900" width="470" height="70" as="geometry"/></mxCell>
        <mxCell id="risk-note" value="风险：Host checkpoint 只能回滚内存对话，不能撤销已经发生的文件、命令或外部工具副作用。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="900" width="500" height="70" as="geometry"/></mxCell>
        <mxCell id="sample-note" value="2026-09-20 样本：102.063s，Host message=连接暂时不稳定。小于单次 120s，属于 Provider/网络瞬时错误，而非前端截断。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="900" width="450" height="70" as="geometry"/></mxCell>
